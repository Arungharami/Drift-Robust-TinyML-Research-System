# Public research-portal configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Collaboration is disabled unless all three values below are deliberately set.
# Never place SUPABASE_SERVICE_ROLE_KEY, invitation secrets, or moderation keys
# in NEXT_PUBLIC_* variables or commit them to this repository.
COLLABORATION_FEATURE_STATE=disabled
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
COLLABORATION_MAX_UPLOAD_BYTES=10485760
