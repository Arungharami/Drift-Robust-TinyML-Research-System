# research-portal environment variables. Copy to .env.local and fill in real values.
# Never commit .env.local or any file containing an actual secret.

# Canonical GitHub repository, used to build outbound links.
NEXT_PUBLIC_GITHUB_REPO=Arungharami/Drift-Robust-TinyML-Research-System

# Optional: Hugging Face namespace/org, once real repos exist (used for outbound links only).
NEXT_PUBLIC_HUGGINGFACE_NAMESPACE=

# Optional: canonical production URL, used for metadata/OpenGraph/sitemap.
NEXT_PUBLIC_SITE_URL=https://drift-robust-tinyml.vercel.app
